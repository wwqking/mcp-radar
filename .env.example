# 站点域名（sitemap / canonical / robots / schema / feed 都用它）。默认 https://www.mcpradars.com
# 注意：与 Cloudflare Worker 的规范域名一致。预览环境用不同域名时在此覆盖。
NEXT_PUBLIC_SITE_URL=https://www.mcpradars.com

# 数据源：mock（默认，写死演示数据）| live（本项目采集器拉真实数据）
NEXT_PUBLIC_DATA_SOURCE=mock

# live 模式采集参数 ---------------------------------------------------------

# 每日 GitHub/npm 深度富化预算。Registry 元数据始终完整分页，不受此值限制。
MCP_COLLECT_LIMIT=800
# 每日优先尝试入库的新 Registry server 数。
MCP_NEW_SERVER_LIMIT=250
# 来源连续缺失几次后才从公开数据集移除。
MCP_MISSING_GRACE_RUNS=3
# Registry 游标分页安全上限，默认 500 页；通常无需修改。
# MCP_REGISTRY_MAX_PAGES=500

# GitHub token：可选但强烈建议。未认证 60 次/小时，token 5000 次/小时。
# 生成：https://github.com/settings/tokens （只需 public_repo 读权限即可）
GITHUB_TOKEN=

# 采集缓存有效期（毫秒），默认 12 小时。调试时可设短。
# MCP_CACHE_TTL_MS=43200000
# 单个 GitHub/npm/Registry 请求超时（毫秒），默认 20 秒，避免整批采集被坏连接挂死。
# MCP_FETCH_TIMEOUT_MS=20000

# 邮件订阅（Buttondown） -----------------------------------------------------
# 配了才开启订阅；未配时 /api/subscribe 返回 503，前端提示「订阅暂未开放」。
# 拿 key：https://buttondown.email/settings/api
# 在 Cloudflare Worker 的 Settings → Builds → Variables and secrets 里加同名 Secret（勿提交 git）。
BUTTONDOWN_API_KEY=

# Google Tag Manager / GA4 ---------------------------------------------------
# 默认已接入 GTM-M27PF8G6；如复制项目或更换容器，可用此变量覆盖。
# GA4 的 Google Tag 及以下自定义事件需在 GTM 容器内配置并发布。
NEXT_PUBLIC_GTM_ID=GTM-M27PF8G6
